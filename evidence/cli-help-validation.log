$ python3 -B bin/dmd --version
0.4.0

$ python3 -B bin/dmd init --help  (first line)
usage: dmd init [-h] [-m MESSAGE] [--request-file REQUEST_FILE]
                --authority AUTHORITY [--session SESSION] [--new]

$ python3 -B bin/dmd req --help  (first line)
usage: dmd req [-h] [--id ID] [--anchor ANCHOR] [--authority AUTHORITY]
               {add,cancel,attest-only} [text]

$ python3 -B bin/dmd work --help  (first line)
usage: dmd work [-h] [--req REQ] [--id ID] [--dep DEP] [--owns OWNS]
                [--status {doing,implemented,todo,verified}] [--note NOTE]

$ python3 -B bin/dmd check --help  (first line)
usage: dmd check [-h] [--req REQ] [--id ID] [--cmd CMD] [--run-cwd RUN_CWD]
                 [--expect EXPECT] [--match MATCH] [--red-match RED_MATCH]

$ python3 -B bin/dmd preview --help  (first line)
usage: dmd preview [-h] id


$ python3 -B bin/dmd approve --help  (first line)
usage: dmd approve [-h] --note NOTE id


$ python3 -B bin/dmd run --help  (first line)
usage: dmd run [-h] [--red] id


$ python3 -B bin/dmd finding --help  (first line)
